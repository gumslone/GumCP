# User configuration — edit include/config.php to set credentials.
# config.example.php is the tracked template; config.php is your live copy.
include/config.php

# User data directories written at runtime by the web server.
# Track the .htaccess files inside them so web access is always blocked.
buttons/*
!buttons/.htaccess
command_logs/*
!command_logs/.htaccess

# CPU stat cache written by ajax.php for accurate polling.
gumcp_cpu_stat

# User-customized menu order persisted by the reorder UI.
include/menu_order.json

# Optional third-party modules — installed on demand via scripts/install-module.sh,
# never vendored into the repo (a bundled copy ships its vulnerabilities and goes stale).
modules/adminer/
modules/tinyfilemanager/
