# Deny all web access to this directory.
#
# This file only takes effect when Apache is configured with AllowOverride for
# the GumCP directory. Debian and Raspberry Pi OS default to "AllowOverride None"
# for /var/www, which silently ignores it — deploy/gumcp-apache.conf places the
# same rules in the server configuration to cover that case. Both layers are
# shipped deliberately; System Check reports which one is actually working.

Options -Indexes

# Apache 2.4 and newer
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (Require all denied is not understood there and would 500)
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
